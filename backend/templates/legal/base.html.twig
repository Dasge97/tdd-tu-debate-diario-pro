<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Tu Debate Diario{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --tdd-dark:   #1A1612;
            --tdd-accent: #6E2733;
            --tdd-cream:  #FAF7F1;
            --tdd-muted:  #8A8070;
        }
        body { background: var(--tdd-cream); color: var(--tdd-dark); font-family: 'Inter', sans-serif; }
        .navbar-brand { font-family: 'Playfair Display', serif; font-size: 1.4rem; color: var(--tdd-dark) !important; letter-spacing: -0.01em; }
        .navbar { background: #fff; border-bottom: 1px solid #e8e2d8; }
        .nav-link { color: var(--tdd-muted) !important; font-size: 0.875rem; }
        .nav-link:hover { color: var(--tdd-accent) !important; }
        .section-title { font-family: 'Playfair Display', serif; }
        .accent { color: var(--tdd-accent); }
        h2, h3 { font-family: 'Playfair Display', serif; margin-top: 2rem; }
        .legal-body { max-width: 760px; }
        footer { background: var(--tdd-dark); color: rgba(255,255,255,0.5); font-size: 0.8rem; }
        footer a { color: rgba(255,255,255,0.6); text-decoration: none; }
        footer a:hover { color: #fff; }
        .chip { display:inline-block; background:#eee; border-radius:20px; padding:2px 10px; font-size:0.75rem; }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/">Tu<span class="accent">Debate</span>Diario</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto gap-3">
                <li class="nav-item"><a class="nav-link" href="/legal/privacidad">Privacidad</a></li>
                <li class="nav-item"><a class="nav-link" href="/legal/terminos">Términos</a></li>
                <li class="nav-item"><a class="nav-link" href="/legal/ia">Política IA</a></li>
                <li class="nav-item"><a class="nav-link" href="/soporte">Soporte</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-5">
    <div class="legal-body mx-auto">
        {% block content %}{% endblock %}
    </div>
</main>

<footer class="py-4 mt-5">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <span>© {{ "now"|date("Y") }} TuDebateDiario — <a href="mailto:info@tudebatediario.com">info@tudebatediario.com</a></span>
        <div class="d-flex gap-3">
            <a href="/legal/privacidad">Privacidad</a>
            <a href="/legal/terminos">Términos</a>
            <a href="/legal/ia">Política IA</a>
            <a href="/soporte">Soporte</a>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
