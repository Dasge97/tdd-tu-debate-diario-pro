{% extends 'admin/base.html.twig' %}
{% block title %}Moderación — Admin TDD{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Moderación</h2>
    <span class="badge bg-dark fs-6">{{ users|length }} usuario{{ users|length != 1 ? 's' : '' }} en shadow ban</span>
</div>

{% if users is empty %}
<div class="card bg-white">
    <div class="card-body text-center py-5 text-muted">
        <i class="bi bi-shield-check fs-1 d-block mb-2"></i>
        No hay usuarios en shadow ban actualmente.
    </div>
</div>
{% else %}
<div class="card bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Score</th>
                    <th>Registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td class="text-muted small">{{ user.id }}</td>
                    <td>
                        <a href="/admin/users/{{ user.id }}" class="fw-semibold text-decoration-none">{{ user.username }}</a>
                        {% if user.status == 'suspended' %}
                        <span class="badge bg-warning text-dark ms-1 small">suspendido</span>
                        {% endif %}
                    </td>
                    <td class="small text-muted">{{ user.email }}</td>
                    <td>{{ user.reliabilityScore }}</td>
                    <td class="small text-muted">{{ user.createdAt|date('d/m/Y') }}</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/admin/users/{{ user.id }}" class="btn btn-xs btn-outline-secondary">Ver</a>
                            <form method="POST" action="/admin/moderation/{{ user.id }}/unban" class="d-inline">
                                <button type="submit" class="btn btn-xs btn-outline-success"
                                    onclick="return confirm('¿Levantar el shadow ban de {{ user.username }}?')">
                                    Desbanear
                                </button>
                            </form>
                            {% if user.status == 'active' %}
                            <form method="POST" action="/admin/users/{{ user.id }}/status" class="d-inline">
                                <input type="hidden" name="status" value="suspended">
                                <input type="hidden" name="redirect" value="/admin/moderation">
                                <button type="submit" class="btn btn-xs btn-outline-warning"
                                    onclick="return confirm('¿Suspender también a {{ user.username }}?')">
                                    Suspender
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
