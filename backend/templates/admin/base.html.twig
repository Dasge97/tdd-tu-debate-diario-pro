<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin — Tu Debate Diario{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body { background: #f5f5f0; font-size: 0.9rem; }
        .sidebar {
            min-height: 100vh;
            background: #1A1612;
            color: #eee;
            padding-top: 1rem;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }
        .sidebar a {
            color: #9C9486;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.55rem 1.2rem;
            border-radius: 0.3rem;
            margin: 0.1rem 0.5rem;
            font-size: 0.85rem;
        }
        .sidebar a:hover, .sidebar a.active { background: #2a2420; color: #FAF7F1; }
        .sidebar .brand {
            font-size: 1rem;
            font-weight: 700;
            color: #FAF7F1;
            padding: 0.5rem 1.2rem 1.5rem;
            border-bottom: 1px solid #2a2420;
            margin-bottom: 0.5rem;
            letter-spacing: 0.05em;
        }
        .sidebar .nav-section {
            font-size: 0.7rem;
            color: #6F665A;
            padding: 1rem 1.2rem 0.3rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        .main-content { padding: 2rem; }
        .badge-running  { background: #ffc107; color: #000; }
        .badge-ok       { background: #4F7548; }
        .badge-error    { background: #9C4232; }
        .stat-card { border: none; border-radius: 8px; }
        .table th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; }
        .btn-xs { padding: 0.15rem 0.5rem; font-size: 0.75rem; }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row g-0">
        {% block sidebar %}
        <div class="col-md-2 sidebar">
            <div class="brand"><i class="bi bi-shield-check me-2"></i>TDD Admin</div>

            <div class="nav-section">General</div>
            <a href="/admin/dashboard" class="{{ app.request.pathInfo starts with '/admin/dashboard' ? 'active' : '' }}">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section">Contenido</div>
            <a href="/admin/debates" class="{{ app.request.pathInfo starts with '/admin/debates' ? 'active' : '' }}">
                <i class="bi bi-chat-square-text"></i> Debates
            </a>
            <a href="/admin/propuestas" class="{{ app.request.pathInfo starts with '/admin/propuestas' ? 'active' : '' }}">
                <i class="bi bi-inbox"></i> Propuestas
            </a>
            <a href="/admin/comments" class="{{ app.request.pathInfo starts with '/admin/comments' ? 'active' : '' }}">
                <i class="bi bi-chat-dots"></i> Comentarios
            </a>

            <div class="nav-section">Comunidad</div>
            <a href="/admin/users" class="{{ app.request.pathInfo starts with '/admin/users' ? 'active' : '' }}">
                <i class="bi bi-people"></i> Usuarios
            </a>
            <a href="/admin/moderation" class="{{ app.request.pathInfo starts with '/admin/moderation' ? 'active' : '' }}">
                <i class="bi bi-shield-exclamation"></i> Moderación
            </a>

            <div class="nav-section">Personajes IA</div>
            <a href="/admin/personas" class="{{ app.request.pathInfo starts with '/admin/personas' ? 'active' : '' }}">
                <i class="bi bi-robot"></i> Personajes
            </a>
            <a href="/admin/worker" class="{{ app.request.pathInfo starts with '/admin/worker' ? 'active' : '' }}">
                <i class="bi bi-gear"></i> Worker IA
            </a>

            <div class="nav-section">Sistema</div>
            <a href="/admin/audit-log" class="{{ app.request.pathInfo starts with '/admin/audit' ? 'active' : '' }}">
                <i class="bi bi-journal-text"></i> Auditoría
            </a>
            <hr style="border-color:#2a2420; margin: 0.5rem 0.8rem;">
            <a href="/admin/logout"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</a>
        </div>
        {% endblock %}
        <div class="col-md-10 main-content">
            {% block content %}{% endblock %}
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
