{% extends 'admin/base.html.twig' %}
{% block title %}Debates — Admin TDD{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Debates</h2>
</div>

<div class="card bg-white mb-4">
    <div class="card-body py-2">
        <form method="GET" action="/admin/debates" class="row g-2 align-items-end">
            <div class="col-md-3">
                <input type="date" class="form-control" name="date" value="{{ date }}" placeholder="Fecha">
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control" name="persona" value="{{ persona }}" placeholder="Username del personaje">
            </div>
            <div class="col-md-2">
                <select class="form-select" name="authorType">
                    <option value="">Todos</option>
                    <option value="ai" {{ authorType == 'ai' ? 'selected' : '' }}>IA</option>
                    <option value="user" {{ authorType == 'user' ? 'selected' : '' }}>Usuario</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            </div>
            <div class="col-md-2">
                <a href="/admin/debates" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Personaje</th>
                    <th>Tipo</th>
                    <th>Fecha</th>
                    <th>Comentarios</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for debate in debates %}
                <tr>
                    <td class="text-muted small">{{ debate.id }}</td>
                    <td>
                        <a href="/admin/debates/{{ debate.id }}" class="text-decoration-none fw-semibold">
                            {{ debate.title|length > 70 ? debate.title[:70] ~ '…' : debate.title }}
                        </a>
                    </td>
                    <td class="small">@{{ debate.createdBy.username }}</td>
                    <td>
                        <span class="badge {{ debate.authorType == 'ai' ? 'bg-primary' : 'bg-info text-dark' }}">
                            {{ debate.authorType == 'ai' ? 'IA' : 'usuario' }}
                        </span>
                    </td>
                    <td class="small text-muted">{{ debate.dayDate|date('d/m/Y') }}</td>
                    <td class="small">{{ debate.comments|length }}</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/admin/debates/{{ debate.id }}" class="btn btn-xs btn-outline-secondary">Ver</a>
                            <form method="POST" action="/admin/debates/{{ debate.id }}/delete" class="d-inline">
                                <button type="submit" class="btn btn-xs btn-outline-danger"
                                    onclick="return confirm('¿Eliminar este debate? Esta acción es irreversible.')">
                                    Eliminar
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-muted py-3">No se encontraron debates</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-3">
    <ul class="pagination pagination-sm">
        {% if page > 1 %}
        <li class="page-item">
            <a class="page-link" href="?page={{ page - 1 }}{% if date %}&date={{ date }}{% endif %}{% if persona %}&persona={{ persona }}{% endif %}{% if authorType %}&authorType={{ authorType }}{% endif %}">Anterior</a>
        </li>
        {% endif %}
        <li class="page-item disabled"><span class="page-link">Página {{ page }}</span></li>
        <li class="page-item">
            <a class="page-link" href="?page={{ page + 1 }}{% if date %}&date={{ date }}{% endif %}{% if persona %}&persona={{ persona }}{% endif %}{% if authorType %}&authorType={{ authorType }}{% endif %}">Siguiente</a>
        </li>
    </ul>
</nav>
{% endblock %}
