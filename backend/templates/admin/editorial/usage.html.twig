{% extends 'admin/base.html.twig' %}
{% block title %}Uso del motor editorial — Admin TDD{% endblock %}

{% block content %}
<a href="/admin/editorial" class="small">&larr; Motor editorial</a>
<h2 class="mt-2 mb-1">Uso por día editorial</h2>
<p class="text-muted mb-4">
    Últimos 30 días. Tokens tal como los devuelve el proveedor{% if model %} ({{ model }}){% endif %}.
    Cuando el proveedor no los devuelve se cuentan como «sin dato», nunca se estiman.
    {% if usage.billing.basis == 'api' and usage.billing.inputPerMTok is not null %}
        Coste con la tarifa de {{ usage.billing.priceDate ?? 'fecha sin indicar' }}: {{ usage.billing.inputPerMTok }} {{ usage.billing.currency }}/M de entrada y {{ usage.billing.outputPerMTok }} {{ usage.billing.currency }}/M de salida.
    {% else %}
        El modelo se paga con una suscripción: no hay coste por token que calcular.
    {% endif %}
</p>

<div class="card bg-white">
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Día</th><th class="text-end">Ejecuciones</th><th class="text-end">Publicados</th><th class="text-end">Válidos</th>
                    <th class="text-end">Llamadas</th><th class="text-end">Fallidas</th><th class="text-end">Entrada</th><th class="text-end">Salida</th>
                    <th class="text-end">Total</th><th class="text-end">Caché</th><th class="text-end">Sin dato</th><th class="text-end">Tokens por debate válido</th><th class="text-end">Tiempo de modelo</th><th class="text-end">Coste</th>
                </tr>
            </thead>
            <tbody>
            {% for r in usage.rows %}
                <tr>
                    <td>{{ r.day|date('d/m/Y') }}</td>
                    <td class="text-end">{{ r.runs }}</td>
                    <td class="text-end">{{ r.published }}</td>
                    <td class="text-end">{{ r.valid_debates }}</td>
                    <td class="text-end">{{ r.calls }}</td>
                    <td class="text-end">{{ r.failed_calls ?? 0 }}</td>
                    <td class="text-end">{{ (r.input_tokens ?? 0)|number_format(0, ',', '.') }}</td>
                    <td class="text-end">{{ (r.output_tokens ?? 0)|number_format(0, ',', '.') }}</td>
                    <td class="text-end fw-semibold">{{ ((r.input_tokens ?? 0) + (r.output_tokens ?? 0))|number_format(0, ',', '.') }}</td>
                    <td class="text-end">{{ r.cached_tokens is null ? '—' : r.cached_tokens|number_format(0, ',', '.') }}</td>
                    <td class="text-end">{{ r.unknown_calls ?? 0 }}</td>
                    <td class="text-end">{{ r.tokens_per_valid is null ? '—' : r.tokens_per_valid|number_format(0, ',', '.') }}</td>
                    <td class="text-end">{{ ((r.llm_ms ?? 0) / 1000)|number_format(0, ',', '.') }} s</td>
                    <td class="text-end">{{ r.cost is null ? '—' : r.cost|number_format(4, ',', '.') ~ ' ' ~ usage.billing.currency }}</td>
                </tr>
            {% else %}
                <tr><td colspan="14" class="text-center text-muted py-3">Sin datos todavía.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
