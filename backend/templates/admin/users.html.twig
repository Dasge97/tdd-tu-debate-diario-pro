{% extends 'admin/base.html.twig' %}
{% block title %}Usuarios — Admin TDD{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Usuarios</h2>
</div>

<div class="card bg-white mb-4">
    <div class="card-body py-2">
        <form method="GET" action="/admin/users" class="row g-2 align-items-end">
            <div class="col-md-8">
                <input type="text" class="form-control" name="search" value="{{ search }}" placeholder="Buscar por usuario o correo…">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
            <div class="col-md-2">
                <a href="/admin/users" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Shadow</th>
                    <th>Score</th>
                    <th>Registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr>
                    <td class="text-muted small">{{ user.id }}</td>
                    <td>
                        <a href="/admin/users/{{ user.id }}" class="fw-semibold text-decoration-none">{{ user.username }}</a>
                    </td>
                    <td class="small text-muted">{{ user.email }}</td>
                    <td>
                        <span class="badge {{ user.role == 'admin' ? 'bg-danger' : 'bg-secondary' }}">{{ user.role }}</span>
                    </td>
                    <td>
                        <span class="badge {{ user.status == 'active' ? 'bg-success' : 'bg-warning text-dark' }}">
                            {{ user.status == 'active' ? 'activo' : 'suspendido' }}
                        </span>
                    </td>
                    <td>
                        {% if user.isShadowBanned %}<span class="badge bg-dark">ban</span>{% endif %}
                    </td>
                    <td>{{ user.reliabilityScore }}</td>
                    <td class="small text-muted">{{ user.createdAt|date('d/m/Y') }}</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="/admin/users/{{ user.id }}" class="btn btn-xs btn-outline-secondary">Ver</a>
                            <form method="POST" action="/admin/users/{{ user.id }}/status" class="d-inline">
                                <input type="hidden" name="redirect" value="/admin/users">
                                {% if user.status == 'active' %}
                                <input type="hidden" name="status" value="suspended">
                                <button type="submit" class="btn btn-xs btn-outline-warning"
                                    onclick="return confirm('¿Suspender a {{ user.username }}?')">Suspender</button>
                                {% else %}
                                <input type="hidden" name="status" value="active">
                                <button type="submit" class="btn btn-xs btn-outline-success">Activar</button>
                                {% endif %}
                            </form>
                            {% if user.isShadowBanned %}
                            <form method="POST" action="/admin/moderation/{{ user.id }}/unban" class="d-inline">
                                <button type="submit" class="btn btn-xs btn-outline-info"
                                    onclick="return confirm('¿Levantar el shadow ban de {{ user.username }}?')">Desbanear</button>
                            </form>
                            {% else %}
                            <form method="POST" action="/admin/moderation/{{ user.id }}/ban" class="d-inline">
                                <input type="hidden" name="redirect" value="/admin/users">
                                <button type="submit" class="btn btn-xs btn-outline-dark"
                                    onclick="return confirm('¿Shadow ban a {{ user.username }}?')">Shadow ban</button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="9" class="text-center text-muted py-3">No se encontraron usuarios</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-3">
    <ul class="pagination pagination-sm">
        {% if page > 1 %}
        <li class="page-item"><a class="page-link" href="?page={{ page - 1 }}{% if search %}&search={{ search }}{% endif %}">Anterior</a></li>
        {% endif %}
        <li class="page-item disabled"><span class="page-link">Página {{ page }}</span></li>
        <li class="page-item"><a class="page-link" href="?page={{ page + 1 }}{% if search %}&search={{ search }}{% endif %}">Siguiente</a></li>
    </ul>
</nav>
{% endblock %}
