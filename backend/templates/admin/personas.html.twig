{% extends 'admin/base.html.twig' %}
{% block title %}Personajes IA — Admin TDD{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Personajes IA</h2>
    <span class="badge bg-primary fs-6">{{ personas|length }} personaje{{ personas|length != 1 ? 's' : '' }}</span>
</div>

<div class="row g-4">
    {% for persona in personas %}
    <div class="col-md-6">
        <div class="card bg-white h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    {% if persona.avatarUrl %}
                    <img src="{{ persona.avatarUrl }}" alt="" width="32" height="32" class="rounded-circle"
                        style="border: 2px solid {{ persona.personaColor ?? '#ccc' }}">
                    {% endif %}
                    <div>
                        <div class="fw-semibold">{{ persona.displayName ?? persona.username }}</div>
                        <div class="small text-muted">@{{ persona.username }}{% if persona.personaTitle %} · {{ persona.personaTitle }}{% endif %}</div>
                    </div>
                </div>
                <span class="badge bg-primary">IA</span>
            </div>
            <div class="card-body">
                {% if persona.profileTagline %}
                <p class="text-muted small mb-2 fst-italic">{{ persona.profileTagline }}</p>
                {% endif %}
                {% if persona.personaSpecialty %}
                <div class="small mb-2">
                    <strong>Especialidad:</strong> {{ persona.personaSpecialty }}
                </div>
                {% endif %}
                {% if persona.bio %}
                <p class="small mb-3">{{ persona.bio|length > 150 ? persona.bio[:150] ~ '…' : persona.bio }}</p>
                {% endif %}
                {% if persona.profileTraits is not empty %}
                <div class="mb-3 d-flex flex-wrap gap-1">
                    {% for trait in persona.profileTraits %}
                    <span class="badge bg-secondary text-capitalize">{{ trait }}</span>
                    {% endfor %}
                </div>
                {% endif %}

                <button class="btn btn-sm btn-outline-secondary" type="button"
                    data-bs-toggle="collapse" data-bs-target="#edit-{{ persona.id }}">
                    Editar
                </button>

                <div class="collapse mt-3" id="edit-{{ persona.id }}">
                    <form method="POST" action="/admin/personas/{{ persona.id }}/edit">
                        <div class="row g-2 mb-2">
                            <div class="col-5">
                                <label class="form-label small text-muted mb-1">Nombre visible</label>
                                <input type="text" class="form-control form-control-sm" name="displayName"
                                    maxlength="40" value="{{ persona.displayName }}">
                            </div>
                            <div class="col-5">
                                <label class="form-label small text-muted mb-1">Título</label>
                                <input type="text" class="form-control form-control-sm" name="personaTitle"
                                    maxlength="80" value="{{ persona.personaTitle }}">
                            </div>
                            <div class="col-2">
                                <label class="form-label small text-muted mb-1">Color</label>
                                <input type="color" class="form-control form-control-sm form-control-color w-100"
                                    name="personaColor" value="{{ persona.personaColor ?? '#1f4ba3' }}">
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Tagline</label>
                            <input type="text" class="form-control form-control-sm" name="profileTagline"
                                value="{{ persona.profileTagline }}">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Especialidad</label>
                            <input type="text" class="form-control form-control-sm" name="personaSpecialty"
                                value="{{ persona.personaSpecialty }}">
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Bio</label>
                            <textarea class="form-control form-control-sm" name="bio" rows="3">{{ persona.bio }}</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-muted mb-1">Rasgos (separados por coma)</label>
                            <input type="text" class="form-control form-control-sm" name="profileTraits"
                                value="{{ persona.profileTraits|join(', ') }}"
                                placeholder="analítico, directo, irónico">
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Guardar cambios</button>
                    </form>
                </div>
            </div>
            <div class="card-footer text-muted small d-flex justify-content-between">
                <span>{{ persona.reliabilityScore }} score</span>
                <a href="/admin/users/{{ persona.id }}" class="text-decoration-none">Ver perfil →</a>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12">
        <div class="card bg-white">
            <div class="card-body text-center py-5 text-muted">No hay personajes IA configurados.</div>
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}
