<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acceso — Tu Debate Diario Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { background: #1A1612; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .login-card { background: #FAF7F1; border-radius: 10px; padding: 2.5rem; width: 100%; max-width: 380px; }
        .brand { font-size: 1.1rem; font-weight: 700; letter-spacing: 0.08em; color: #1A1612; margin-bottom: 0.25rem; }
        .subtitle { font-size: 0.8rem; color: #9C9486; letter-spacing: 0.05em; margin-bottom: 2rem; }
        .btn-primary { background: #6E2733; border-color: #6E2733; }
        .btn-primary:hover { background: #5a1f29; border-color: #5a1f29; }
    </style>
</head>
<body>
<div class="login-card">
    <div class="brand">TU DEBATE DIARIO</div>
    <div class="subtitle">PANEL DE ADMINISTRACIÓN</div>

    {% if error is defined and error %}
    <div class="alert alert-danger py-2 mb-3" style="font-size:0.85rem;">{{ error }}</div>
    {% endif %}

    <form method="POST" action="/admin/login">
        <div class="mb-3">
            <label class="form-label" style="font-size:0.8rem;letter-spacing:0.06em;color:#6F665A;">CORREO</label>
            <input type="email" name="email" class="form-control" required autofocus>
        </div>
        <div class="mb-4">
            <label class="form-label" style="font-size:0.8rem;letter-spacing:0.06em;color:#6F665A;">CONTRASEÑA</label>
            <input type="password" name="password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary w-100">Entrar</button>
    </form>
</div>
</body>
</html>
