{% extends 'admin/base.html.twig' %}
{% block title %}Dashboard — Admin TDD{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Dashboard</h2>
    <span class="text-muted small">Bienvenido, {{ admin.username }}</span>
</div>

{# Fila 1: métricas principales #}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card bg-white p-3 h-100">
            <div class="text-muted small mb-1" style="font-size:0.72rem;letter-spacing:0.08em;">USUARIOS</div>
            <div class="fw-bold fs-3">{{ stats.totalUsers }}</div>
            <div class="text-success small">+{{ stats.newUsers }} este mes</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card bg-white p-3 h-100">
            <div class="text-muted small mb-1" style="font-size:0.72rem;letter-spacing:0.08em;">DEBATES TOTALES</div>
            <div class="fw-bold fs-3">{{ stats.totalDebates }}</div>
            <div class="text-primary small">{{ stats.todayDebates }} hoy</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card bg-white p-3 h-100">
            <div class="text-muted small mb-1" style="font-size:0.72rem;letter-spacing:0.08em;">COMENTARIOS</div>
            <div class="fw-bold fs-3">{{ stats.totalComments }}</div>
            <div class="text-muted small">{{ stats.activeUsers }} usuarios activos (7d)</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card p-3 h-100 {{ stats.workerEnabled ? 'bg-success text-white' : 'bg-secondary text-white' }}">
            <div class="small mb-1" style="font-size:0.72rem;letter-spacing:0.08em;">WORKER IA</div>
            <div class="fw-bold fs-5">{{ stats.workerEnabled ? 'Activo' : 'Inactivo' }}</div>
            <div class="small opacity-75">{{ stats.successRate }}% éxito (10 runs)</div>
        </div>
    </div>
</div>

{# Fila 2: alertas operativas #}
<div class="row g-3 mb-4">
    {% if stats.shadowBanned > 0 %}
    <div class="col-md-4">
        <div class="card bg-warning bg-opacity-25 border-warning p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-exclamation fs-4 text-warning"></i>
                <div>
                    <div class="fw-semibold">{{ stats.shadowBanned }} usuario{{ stats.shadowBanned != 1 ? 's' : '' }} en shadow ban</div>
                    <a href="/admin/moderation" class="small">Revisar moderación →</a>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    {% if stats.userProposals > 0 %}
    <div class="col-md-4">
        <div class="card bg-info bg-opacity-25 border-info p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-inbox fs-4 text-info"></i>
                <div>
                    <div class="fw-semibold">{{ stats.userProposals }} propuesta{{ stats.userProposals != 1 ? 's' : '' }} de usuarios</div>
                    <a href="/admin/propuestas" class="small">Ver propuestas →</a>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

{# Últimas ejecuciones del worker #}
<h5 class="mb-3">Últimas ejecuciones del worker</h5>
<div class="card bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Run ID</th>
                    <th>Estado</th>
                    <th>Debates</th>
                    <th>Inicio</th>
                    <th>Duración</th>
                </tr>
            </thead>
            <tbody>
                {% for run in stats.recentRuns %}
                <tr>
                    <td><code class="small">{{ run.id[:8] }}…</code></td>
                    <td><span class="badge badge-{{ run.status }}">{{ run.status }}</span></td>
                    <td>{{ run.debatesGenerated }}</td>
                    <td>{{ run.startedAt|date('d/m H:i') }}</td>
                    <td>
                        {% if run.finishedAt %}
                            {{ ((run.finishedAt.timestamp - run.startedAt.timestamp))|abs }}s
                        {% else %}—{% endif %}
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-muted py-3">Sin ejecuciones registradas</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3">
    <a href="/admin/worker" class="btn btn-sm btn-outline-secondary">Configurar worker</a>
</div>
{% endblock %}
