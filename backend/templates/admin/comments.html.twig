{% extends 'admin/base.html.twig' %}
{% block title %}Comentarios — Admin TDD{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Comentarios</h2>
</div>

<div class="card bg-white mb-4">
    <div class="card-body py-2">
        <form method="GET" action="/admin/comments" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" class="form-control" name="username" value="{{ username }}"
                    placeholder="Username del autor">
            </div>
            <div class="col-md-4">
                <input type="number" class="form-control" name="debateId" value="{{ debateId }}"
                    placeholder="ID del debate">
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            </div>
            <div class="col-md-2">
                <a href="/admin/comments" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Autor</th>
                    <th>Debate</th>
                    <th>Contenido</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for comment in comments %}
                <tr>
                    <td class="text-muted small">{{ comment.id }}</td>
                    <td class="small">
                        <a href="/admin/users/{{ comment.author.id }}" class="text-decoration-none">
                            @{{ comment.author.username }}
                        </a>
                    </td>
                    <td class="small">
                        <a href="/admin/debates/{{ comment.debate.id }}" class="text-decoration-none text-muted">
                            #{{ comment.debate.id }}
                        </a>
                    </td>
                    <td class="small">{{ comment.content|length > 100 ? comment.content[:100] ~ '…' : comment.content }}</td>
                    <td class="small text-muted">{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                    <td>
                        <form method="POST" action="/admin/comments/{{ comment.id }}/delete" class="d-inline">
                            <input type="hidden" name="redirect" value="/admin/comments?page={{ page }}{% if username %}&username={{ username }}{% endif %}{% if debateId %}&debateId={{ debateId }}{% endif %}">
                            <button type="submit" class="btn btn-xs btn-outline-danger"
                                onclick="return confirm('¿Eliminar este comentario?')">Eliminar</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="6" class="text-center text-muted py-3">No se encontraron comentarios</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<nav class="mt-3">
    <ul class="pagination pagination-sm">
        {% if page > 1 %}
        <li class="page-item">
            <a class="page-link" href="?page={{ page - 1 }}{% if username %}&username={{ username }}{% endif %}{% if debateId %}&debateId={{ debateId }}{% endif %}">Anterior</a>
        </li>
        {% endif %}
        <li class="page-item disabled"><span class="page-link">Página {{ page }}</span></li>
        <li class="page-item">
            <a class="page-link" href="?page={{ page + 1 }}{% if username %}&username={{ username }}{% endif %}{% if debateId %}&debateId={{ debateId }}{% endif %}">Siguiente</a>
        </li>
    </ul>
</nav>
{% endblock %}
