###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=CHANGE_ME_long_random_32_chars
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# MySQL 8 — ajusta host/user/pass para tu entorno
DATABASE_URL="mysql://tdd_user:tdd_pass@db:3306/tdd_app?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN=^https?://localhost(:[0-9]+)?$
###< nelmio/cors-bundle ###

# JWT — clave secreta para firmar tokens
JWT_SECRET=CHANGE_ME_long_random_jwt_secret

# Worker — clave compartida con el worker Node.js
WORKER_API_KEY=CHANGE_ME_worker_api_key

# WebSocket
WS_PORT=8080
