# Entornos — NUNCA commitear
# Solo el .env de la raiz, que es el de docker-compose con los secretos reales.
/.env
# backend/.env es la plantilla de Symfony, con valores de ejemplo. Symfony la
# necesita en tiempo de ejecucion, asi que va versionada.
!backend/.env
backend/.env.local
backend/.env.local.php
backend/.env.*.local
worker/.env
mobile/.env

# Dependencias
worker/node_modules/
mobile/.pub-cache/

# Logs y datos efímeros
worker/logs/*.log
worker/logs/*.jsonl
docker-data/
backend/var/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Web compilada de /app (se genera en el build de Docker)
backend/public/app/

# Documento operativo del servidor, no se publica
README_DEPLOY.md
