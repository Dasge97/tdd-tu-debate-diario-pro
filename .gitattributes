# Auto-detect text files and enforce LF line endings
* text=auto eol=lf

# Force LF for PHP, JS, Dart, yaml, md
*.php text eol=lf
*.js text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.env text eol=lf
*.example text eol=lf
*.gitignore text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
