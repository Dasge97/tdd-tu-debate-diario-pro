BACKEND_API_BASE_URL=http://localhost:3000
WORKER_API_KEY=CHANGE_ME_worker_api_key

# Motor V2: el modelo, su dirección y su clave se configuran en el panel
# (/admin/editorial), no aquí.

# Motor V1 (antiguo): CLI de IA instalado en la máquina (claude, opencode, etc.)
AI_CLI_COMMAND=claude
AI_CLI_ARGS=-p --no-markdown

LOG_LEVEL=info
